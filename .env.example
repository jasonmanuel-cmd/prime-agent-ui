# Environment variables for Vercel deployment
# These must be set in Vercel project settings (Environment Variables)

# API server URL (the FastAPI server running on port 8082)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8082
LEAD_SCORING_API_URL=http://127.0.0.1:8082

# VAPI API key for voice agents (if using VAPI integration)
NEXT_PUBLIC_VAPI_API_KEY=

# PayPal credentials (set in Vercel env, not committed)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=production

# Telnyx SMS credentials (set in Vercel env, not committed)
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=
TELNYX_MQ_ID=

# Twilio fallback (set in Vercel env, not committed)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Database
DATABASE_URL=

# OpenRouter API key for lead scoring
OPENROUTER_API_KEY=

# Supermemory API key
SUPERMEMORY_API_KEY=
